# Copy this file to local.env and replace the sample values.
WORLDCUP_BOT_TOKEN=replace-with-your-bot-token
WORLDCUP_ALLOWED_CHAT_IDS=-1001234567890
WORLDCUP_ADMIN_USER_IDS=123456789

# Required only when running in webhook mode.
WORLDCUP_WEBHOOK_SECRET=replace-with-a-random-secret

# Keep test and production bot tokens separate. Never opt in during a local trial.
WORLDCUP_MODE=polling
WORLDCUP_ALLOW_WEBHOOK_RESET=false
# Work/storage limits, not a monetary budget.
WORLDCUP_GLOBAL_PER_MINUTE=120
WORLDCUP_CHAT_PER_MINUTE=30
WORLDCUP_USER_PER_MINUTE=10
WORLDCUP_MAX_PLAYERS=500
WORLDCUP_MAX_MATCHES=1000
WORLDCUP_MAX_RECEIPTS=100000
